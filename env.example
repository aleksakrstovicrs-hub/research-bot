# Kopiraj u .env i popuni. .env nikad ne ide u git.

# Kako se bot predstavlja OpenStreetMap-u (obavezno: ime i kontakt)
BOT_USER_AGENT=ResearchBot/0.1 (+https://tvoj-sajt.rs; kontakt@tvoj-sajt.rs)

# Google Cloud API ključ (PageSpeed Insights API)
GOOGLE_API_KEY=

# Putanja do JSON ključa service account-a (za Google Sheets)
GOOGLE_SA_FILE=credentials/service-account.json

# ID tabele: deo URL-a između /d/ i /edit
SHEET_ID=

# Telegram bot (od @BotFather) i tvoj chat id (skripta ti pomaže da ga nađeš)
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# OpenAI API (ocena dizajna sa screenshota; model mora da podržava slike)
OPENAI_API_KEY=
OPENAI_MODEL=

# Prag ocene prilike za automatski status za_kontakt
MIN_SCORE_FOR_CONTACT=40

# ---- Faza 2: slanje mejlova ----
# Slanje ostaje isključeno dok ne staviš 1
SENDING_ENABLED=0
FROM_NAME=
FROM_EMAIL=
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
IMAP_HOST=
IMAP_PORT=993
IMAP_SENT_FOLDER=INBOX.Sent
# Zagrevanje: prve nedelje 5–8, pa postepeno do 20–30
DAILY_LIMIT=8
SEND_HOURS=9-16
MIN_GAP_MINUTES=7
# Potpis
SIGNATURE_TITLE=Izrada sajtova i AI automatizacije
SIGNATURE_PHONE=
SIGNATURE_WEB=
# Automatski nacrti: posle /trazi (0 = isključeno) i svakog radnog dana ujutru (0 = isključeno)
DRAFTS_AFTER_SEARCH=5
MORNING_DRAFTS=8
MORNING_DRAFTS_TIME=08:30

# ---- Portal za klijente (poseban bot od @BotFather) ----
PORTAL_BOT_TOKEN=
